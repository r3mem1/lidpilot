{
  "mcpServers": {
    "sqlite": {
      "command": "uvx",
      "args": [
        "--with",
        "mcp<2",
        "mcp-server-sqlite",
        "--db-path",
        "./leadpilot.db"
      ]
    },
    "fetch": {
      "command": "uvx",
      "args": [
        "mcp-server-fetch"
      ]
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--browser",
        "chromium",
        "--executable-path",
        "C:\\Program Files\\Yandex\\YandexBrowser\\Application\\browser.exe"
      ]
    }
  }
}
