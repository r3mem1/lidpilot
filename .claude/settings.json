{
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "supabase@claude-plugins-official": false,
    "playwright@claude-plugins-official": false,
    "vercel@claude-plugins-official": false,
    "pr-review-toolkit@claude-plugins-official": false,
    "feature-dev@claude-plugins-official": false,
    "code-simplifier@claude-plugins-official": false,
    "hookify@claude-plugins-official": false,
    "claude-md-management@claude-plugins-official": false,
    "semgrep@claude-plugins-official": false
  },
  "env": {
    "PYTHONUTF8": "1",
    "BASH_MAX_OUTPUT_LENGTH": "20000",
    "MAX_MCP_OUTPUT_TOKENS": "15000"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/hooks/ruff_after_edit.py\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(python scripts/run_checks.py:*)",
      "Bash(python scripts/show_logs.py:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(ruff check:*)",
      "Bash(ruff format --check:*)",
      "Bash(pyright:*)",
      "Bash(alembic current:*)",
      "Bash(alembic heads:*)",
      "Bash(alembic history:*)",
      "mcp__sqlite__read_query",
      "mcp__sqlite__list_tables",
      "mcp__sqlite__describe_table"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./*.db)",
      "Read(./*.sqlite3)",
      "Read(./static/fonts/**)",
      "Read(./__pycache__/**)",
      "Read(./.ruff_cache/**)",
      "Read(./.test_logs/**)",
      "Read(./e2e-shots/**)",
      "Read(./.venv/**)",
      "Read(./venv/**)",
      "Read(./.pytest_cache/**)",
      "Read(./.mypy_cache/**)",
      "Read(./htmlcov/**)",
      "Read(./.coverage)",
      "Read(./migrations/versions/__pycache__/**)"
    ]
  }
}
