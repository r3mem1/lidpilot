{
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "supabase@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "vercel@claude-plugins-official": false,
    "pr-review-toolkit@claude-plugins-official": false,
    "feature-dev@claude-plugins-official": false,
    "code-simplifier@claude-plugins-official": false,
    "hookify@claude-plugins-official": false,
    "claude-md-management@claude-plugins-official": false,
    "semgrep@claude-plugins-official": false
  },
  "env": {
    "PYTHONUTF8": "1",
    "BASH_MAX_OUTPUT_LENGTH": "20000"
  },
  "permissions": {
    "allow": [
      "Bash(python scripts/run_checks.py:*)",
      "Bash(python scripts/show_logs.py:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./*.db)",
      "Read(./*.sqlite3)",
      "Read(./static/fonts/**)",
      "Read(./__pycache__/**)",
      "Read(./.ruff_cache/**)",
      "Read(./.test_logs/**)",
      "Read(./e2e-shots/**)"
    ]
  }
}