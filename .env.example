# LeadPilot — пример файла окружения (раздел 16 ТЗ).
# Скопируйте в .env и подставьте свои значения. Файл .env в git не попадает.
#
# ======================= БЫСТРАЯ ЛОКАЛЬНАЯ ПРОВЕРКА =======================
# Чтобы запустить проект и проверить админ-панель, в .env достаточно 3 правок
# (места помечены «>>> ВСТАВИТЬ / ИЗМЕНИТЬ» ниже, всё остальное можно не трогать):
#   1. JWT_SECRET             — вставить случайную строку (команда указана у поля)
#   2. AI_PROVIDER=stub       — изменить, чтобы не нужен был ключ LLM
#   3. BOOTSTRAP_ADMIN_EMAIL / BOOTSTRAP_ADMIN_PASSWORD — вставить логин и пароль админа
# Telegram, PUBLIC_BASE_URL, SECRETS_ENCRYPTION_KEY для проверки панели НЕ нужны.
# После правок:  alembic upgrade head  →  python scripts/seed_demo.py  →  uvicorn main:app --reload
# Затем http://127.0.0.1:8000/login → войти админом → откроется /admin.
# ===========================================================================

# --- Приложение ---
APP_NAME=LeadPilot
ENVIRONMENT=development
DEBUG=false

# --- База данных ---
# Разработка (SQLite):
DATABASE_URL=sqlite:///./leadpilot.db
# Production (PostgreSQL/Supabase):
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/leadpilot
DB_ECHO=false
# true — создать таблицы из моделей при старте (только локально, вместо Alembic)
AUTO_CREATE_TABLES=false

# --- Аутентификация ---
# >>> ВСТАВИТЬ: обязательный секрет, минимум 32 символа. Без него приложение не запустится.
# Сгенерировать и вставить результат вместо заглушки:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=ЗАМЕНИТЕ_НА_СЛУЧАЙНУЮ_СТРОКУ_НЕ_МЕНЕЕ_32_СИМВОЛОВ
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=720
AUTH_COOKIE_NAME=leadpilot_access_token
# Локально по HTTP нужно false, в production обязательно true
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
PASSWORD_MIN_LENGTH=8

# --- Ограничение частоты запросов (раздел 16) ---
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=300

# --- HTTPS (раздел 16, только production) ---
FORCE_HTTPS=false

# --- AI-модуль (разделы 9, 12) ---
# >>> ИЗМЕНИТЬ для локальной проверки: AI_PROVIDER=stub (ключ и модель тогда не нужны).
# Для настоящего LLM оставьте openrouter и заполните AI_API_KEY и AI_MODEL.
# openrouter — OpenRouter (https://openrouter.ai). Нужны только AI_API_KEY и AI_MODEL.
# stub — офлайн-режим без обращений к LLM (правила + шаблон по данным БД).
#        Годится для разработки и тестов, в production запрещён.
# openai_compatible — любой другой сервис с /chat/completions (укажите AI_API_BASE_URL).
AI_PROVIDER=openrouter
AI_API_KEY=
# Идентификатор модели с openrouter.ai/models, например openai/gpt-4o-mini
AI_MODEL=
# AI_API_BASE_URL=https://openrouter.ai/api/v1
# Необязательно: более дешёвая модель для классификации
AI_CLASSIFIER_MODEL=
AI_TIMEOUT_SECONDS=20
AI_MAX_RETRIES=2
AI_TEMPERATURE=0.2
AI_MAX_RESPONSE_CHARS=700
AI_HISTORY_TURNS=10
# Диагностический endpoint POST /businesses/{id}/ai/preview (вне раздела 11 ТЗ)
AI_PREVIEW_ENABLED=true
# Ограничение проверок ответа в кабинете (каждая — платный запрос к LLM), в минуту на пользователя
AI_PREVIEW_RATE_LIMIT_PER_MINUTE=20
# Срок действия ссылки-приглашения сотрудника, дней
INVITATION_TTL_DAYS=7

# Тарифы и пробный период (этап 6, панель ADMIN). ТЗ тарифную сетку не задаёт —
# значения-заглушки для расчёта MRR; платежей в MVP нет (§19).
TRIAL_DAYS=14
PLAN_PRICE_START_RUB=1990
PLAN_PRICE_PRO_RUB=4990

# --- Telegram и обработка сообщений (этап 3, разделы 11, 16, 18) ---
# Публичный HTTPS-адрес приложения: Telegram присылает webhook на
# {PUBLIC_BASE_URL}/webhooks/telegram. Локально: cloudflared tunnel --url http://localhost:8000
# (или ngrok) и подставить выданный https-адрес.
PUBLIC_BASE_URL=
# Ключ шифрования токенов ботов в БД (любая случайная строка от 32 символов,
# сгенерировать так же, как JWT_SECRET). Пусто — ключ выводится из JWT_SECRET;
# в production задавать обязательно.
SECRETS_ENCRYPTION_KEY=
# Токен бота НЕ хранится в .env: владелец компании вводит его при подключении
# (POST /businesses/{id}/integrations/telegram), в БД он лежит зашифрованным.
# Повторная обработка сообщений, застрявших после сбоя (0 — выключено):
REPROCESS_INTERVAL_SECONDS=60
MESSAGE_MAX_ATTEMPTS=3
# Число доверенных прокси перед приложением (Render/Cloudflare — 1–2).
# 0 — X-Forwarded-For игнорируется (его может подделать клиент).
TRUSTED_PROXY_COUNT=0

# --- Мониторинг (этап 7, раздел 17) ---
# DSN проекта Sentry (Settings → Client Keys). Пусто — трекер выключен.
# В Sentry не уходят тела запросов, заголовки, токены ботов и email (monitoring.py).
SENTRY_DSN=
# Доля запросов с трассировкой производительности: 0 — только ошибки.
SENTRY_TRACES_SAMPLE_RATE=0

# --- Первый администратор платформы (раздел 5: ADMIN) ---
# Создаётся при старте, если пользователя с таким email ещё нет.
# >>> ВСТАВИТЬ: логин и пароль администратора — ими входите в панель /admin.
# Нужен настоящий домен: адреса вида admin@leadpilot.local вход отклонит.
# Пример: BOOTSTRAP_ADMIN_EMAIL=admin@example.com  и пароль от 8 символов.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
